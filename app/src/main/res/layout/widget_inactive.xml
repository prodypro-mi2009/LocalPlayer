<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="13sp" android:gravity="center" android:maxLines="3" android:ellipsize="end"/>
</LinearLayout>
